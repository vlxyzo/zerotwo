	"homepage": "https://github.com/vlxyzo/zerotwo#README",
	"bugs": {
		"email": "liabeyourgf@gmail.com",
		"url": "https://github.com/vlxyzo/zerotwo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vlxyzo/zerotwo.git"
	},
	"funding": [
		{
			"type": "002 Bot",
			"url": "https://t.me/codezero2_bot"
		},
		{
			"type": "Telegram Channel",
			"url": "https://t.me/vlxzo"
		}
	],
	"private": true,
	"type": "module",
	"main": "start.ts",
	"scripts": {
		"start": "tsx --env-file=.env start.ts",
		"dev": "tsx watch --env-file=.env start.ts",
		"clean": "node -e \"const fs = require('fs'); fs.rmSync('database', { recursive: true, force: true }); fs.mkdirSync('database');\"",
		"update": "git pull && npm install"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.0.0"
	},
	"imports": {
		"#database/*": "./database/*",
		"#sys/*": "./script/system/*",
		"#lib/*": "./script/library/*",
		"#plug/*": "./script/plugin/*",
		"#src/*": "./source/*"
	},
	"dependencies": {
		"telegraf": "^4.16.3"
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	}
}
